BOT_TOKEN=123456:ABC...
# Telegram ID администраторов через запятую: им приходят новые записи и доступна /admin
ADMIN_IDS=
DB_URL=sqlite+aiosqlite:///barber.db
SHOP_NAME=Барбершоп «Бритва»
SHOP_ADDRESS=ул. Демонстрационная, 7
SHOP_PHONE=+7 900 000-00-00
SHOP_TZ=Europe/Moscow
# Клиент сам отменяет или переносит запись не позже чем за столько часов
CANCEL_HOURS=3

# Хостинг. Локально не нужно: бот работает на long-polling.
# USE_WEBHOOK=true включает webhook и раздачу сайта тем же процессом.
# PUBLIC_URL — внешний https-адрес; на Render подставится сам из RENDER_EXTERNAL_URL.
# Внимание: локальный запуск на polling снимает webhook прода.
USE_WEBHOOK=false
# PUBLIC_URL=https://britva-barber.onrender.com
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
